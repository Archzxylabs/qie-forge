{
  "schema_version": "1.0.0",
  "description": "Instruction and skill projection matrix for coding agents. The canonical .agents/skills installation is shared by every agent whose skillsDir is .agents/skills. Agent-specific entries only add instruction files or a non-shared skills projection.",
  "canonical": {
    "id": "universal",
    "label": "Universal .agents/skills",
    "cli_agent": "universal",
    "project_skills": ".agents/skills",
    "global_skills": "~/.agents/skills",
    "detect": [],
    "instructions": [
      {
        "path": "AGENTS.md",
        "format": "markdown",
        "body": "full"
      }
    ]
  },
  "agents": [
    {
      "id": "opencode",
      "label": "OpenCode",
      "cli_agent": "opencode",
      "project_skills": ".agents/skills",
      "global_skills": "~/.agents/skills",
      "detect": [
        ".opencode",
        "opencode.json",
        "opencode.jsonc"
      ],
      "instructions": [
        {
          "path": "AGENTS.md",
          "format": "markdown",
          "body": "full"
        },
        {
          "path": "opencode.jsonc",
          "format": "opencode-config",
          "template": "opencode.jsonc",
          "optional": true
        }
      ]
    },
    {
      "id": "claude-code",
      "label": "Claude Code",
