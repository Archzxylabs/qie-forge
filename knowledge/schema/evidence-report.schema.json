{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qie-forge.invalid/schema/evidence-report.json",
  "description": "Scoped transaction evidence output (PRD §14.4 contract). The finality check is frozen to UNKNOWN in this schema version, so applicationOutcome APPLICATION_VERIFIED cannot validate: it is permitted only when finality PASS carries reviewed policy evidence.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "networkId": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/network"
    },
    "expectedChainId": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/chainId"
    },
    "expectedAction": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "GENERIC_TX",
            "DEPLOY_DIRECT",
            "MINT"
          ]
        },
        "txHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "expectedContractAddress": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "expectedTo": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "expectedPostcondition": {
          "enum": [
            "runtime-code-present",
            null
          ]
        }
      },
      "required": [
        "kind",
        "txHash",
        "expectedContractAddress",
        "expectedTo",
        "expectedPostcondition"
      ],
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "properties": {
        "chainId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "transactionTo": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "receiptContractAddress": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "receiptBlockHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "receiptBlockNumber": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "receiptStatus": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ]
        },
        "codePresent": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "chainId",
        "transactionTo",
        "receiptContractAddress",
        "receiptBlockHash",
        "receiptBlockNumber",
        "receiptStatus",
        "codePresent"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "properties": {
        "inclusion": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ]
        },
        "execution": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ]
        },
        "identityLinkage": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ]
        },
        "applicationEffect": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ]
        },
        "finality": {
          "enum": [
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "inclusion",
        "execution",
        "identityLinkage",
        "applicationEffect",
        "finality"
      ],
      "additionalProperties": false
    },
    "applicationOutcome": {
      "enum": [
        "APPLICATION_VERIFIED",
        "APPLICATION_FAILED",
        "UNKNOWN",
        "PENDING",
        "NOT_RUN"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generatedAt": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/nullableTimestamp"
    },
    "limitedObservation": {
      "enum": [
        "CONFIRMED_AT_BLOCK",
        null
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "$ref": "https://qie-forge.invalid/schema/error-code.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "networkId",
    "expectedChainId",
    "expectedAction",
    "observed",
    "checks",
    "applicationOutcome",
    "evidenceRefs",
    "generatedAt",
    "warnings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "applicationOutcome": {
            "const": "APPLICATION_VERIFIED"
          }
        },
        "required": [
          "applicationOutcome"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "object",
            "properties": {
              "finality": {
                "enum": [
                  "PASS"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
