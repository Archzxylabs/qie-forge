{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qie-forge.invalid/schema/release.json",
  "type": "object",
  "properties": {
    "release_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "built_at": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/timestamp"
    },
    "sources_checked_at": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/nullableTimestamp"
    }
  },
  "required": [
    "release_version",
    "schema_version",
    "built_at",
    "sources_checked_at"
  ],
  "additionalProperties": false
}
