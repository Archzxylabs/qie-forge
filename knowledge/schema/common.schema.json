{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qie-forge.invalid/schema/common.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "network": {
      "enum": [
        "qie-mainnet",
        "qie-testnet"
      ]
    },
    "networks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/network"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "navigationScope": {
      "type": "array",
      "items": { "enum": ["qie-mainnet", "qie-testnet", "qie-native", "general"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "category": {
      "enum": [
        "networks",
        "wallets",
        "frameworks",
        "identity",
        "explorers",
        "defi",
        "bridges",
        "oracles",
        "indexing",
        "native-cosmos"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullableTimestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chainId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "localPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[A-Za-z0-9_./-]+$"
    }
  }
}
