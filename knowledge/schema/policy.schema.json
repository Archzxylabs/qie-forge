{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qie-forge.invalid/schema/policy.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.4.0"
    },
    "status_precedence": {
      "type": "array",
      "const": [
        "CONFLICTED",
        "DEPRECATED",
        "UNSUPPORTED",
        "STALE",
        "UNKNOWN",
        "CLAIMED",
        "DOCUMENTED",
        "VERIFIED"
      ],
      "items": {
        "$ref": "https://qie-forge.invalid/schema/status.json"
      },
      "uniqueItems": true,
      "minItems": 8,
      "maxItems": 8
    },
    "require_explicit_expiry_for_verified": {
      "const": true
    },
    "require_live_check_for_writes": {
      "const": true
    },
    "offline_high_risk_status": {
      "const": "UNKNOWN"
    },
    "expiry_mode": {
      "const": "explicit-record"
    },
    "timestamp_rule": {
      "const": "UTC-RFC3339"
    }
  },
  "required": [
    "schema_version",
    "status_precedence",
    "require_explicit_expiry_for_verified",
    "require_live_check_for_writes",
    "offline_high_risk_status",
    "expiry_mode",
    "timestamp_rule"
  ],
  "additionalProperties": false
}
