{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qie-forge.invalid/schema/claim.json",
  "type": "object",
  "properties": {
    "claim_id": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/id"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "network_id": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/network"
    },
    "source_ids": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/ids"
    },
    "status": {
      "$ref": "https://qie-forge.invalid/schema/status.json"
    },
    "evidence_type": {
      "enum": [
        "CHAIN_OBSERVATION",
        "EXECUTED_TEST",
        "OFFICIAL_DOC",
        "PROVIDER_DOC",
        "COMMUNITY_REPORT",
        null
      ]
    },
    "evidence_test_ids": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/ids"
    },
    "checked_at": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/nullableTimestamp"
    },
    "expires_at": {
      "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/nullableTimestamp"
    },
    "maintainer": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "version_scope": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "claim_id",
    "subject",
    "predicate",
    "value",
    "network_id",
    "source_ids",
    "status",
    "evidence_type",
    "evidence_test_ids",
    "checked_at",
    "expires_at",
    "maintainer",
    "risk_level",
    "version_scope"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "predicate": { "const": "chain_id" } }, "required": ["predicate"] },
      "then": { "properties": { "value": { "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/chainId" } } }
    },
    {
      "if": { "properties": { "predicate": { "enum": ["rpc_url", "explorer_url", "faucet_url"] } }, "required": ["predicate"] },
      "then": { "properties": { "value": { "$ref": "https://qie-forge.invalid/schema/common.json#/$defs/httpsUrl" } } }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_ids": {
            "minItems": 1,
            "type": "array"
          },
          "evidence_test_ids": {
            "minItems": 1,
            "type": "array"
          },
          "checked_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "evidence_type": {
            "enum": [
              "CHAIN_OBSERVATION",
              "EXECUTED_TEST"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DOCUMENTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_ids": {
            "minItems": 1,
            "type": "array"
          },
          "evidence_type": {
            "enum": [
              "OFFICIAL_DOC",
              "PROVIDER_DOC"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "CLAIMED",
              "UNSUPPORTED",
              "DEPRECATED",
              "CONFLICTED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_ids": {
            "minItems": 1,
            "type": "array"
          },
          "evidence_type": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
